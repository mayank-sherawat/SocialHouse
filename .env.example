# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- Database (PostgreSQL, e.g. Neon) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- NextAuth ----
# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ---- Cloudinary (image storage) ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Resend (transactional email / OTP) ----
# Leave RESEND_API_KEY empty in local dev to log codes to the server console.
RESEND_API_KEY=""
EMAIL_FROM="SocialHouse <no-reply@yourdomain.com>"

# ---- Cron (scheduled cleanup) ----
# Secret that Vercel Cron sends as `Authorization: Bearer <value>`.
# Generate with: openssl rand -base64 32
CRON_SECRET=""
