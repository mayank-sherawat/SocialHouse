// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // adjust shadowDatabaseUrl if you run migrations in CI
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  image     String? // profile picture URL
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  photos    Photo[]  @relation("UserPhotos")

  emailVerified Boolean @default(false)

  followers Follow[] @relation("Following")
  following Follow[] @relation("Follower")
  likes     Like[]
}

model Photo {
  id        String   @id @default(cuid())
  imageUrl  String
  caption   String?
  publicId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], name: "UserPhotos", onDelete: Cascade)
  userId    String
  likes     Like[]

  @@index([userId])
}

model Like {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  photoId   String
  createdAt DateTime @default(now())

  @@unique([userId, photoId])
  @@index([photoId])
}

model Follow {
  id String @id @default(cuid())

  follower   User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId String

  following   User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model EmailOTP {
  id        String   @id @default(cuid())
  email     String
  otp       String // bcrypt hash of the 6-digit code, never the plaintext
  attempts  Int      @default(0) // failed verification attempts (capped)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  otp       String // bcrypt hash of the reset code
  attempts  Int      @default(0) // failed verification attempts (capped)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// Fixed-window rate limiter store (serverless-safe; no external infra).
// One row per `key` (e.g. "send-otp:user@example.com", "login:1.2.3.4").
model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

